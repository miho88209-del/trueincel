; Engine configuration file.
config_version=5

[application]

config/name="The Last Whistle"
config/description="A short atmospheric survival-horror train journey to Greyhaven."
config/version="1.0.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/settings.gd"
Loc="*res://scripts/loc.gd"
Sfx="*res://scripts/audio.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=false
